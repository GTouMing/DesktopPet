/.codemoss/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Local Live2D pet packs (Cubism models are large and separately licensed -
# never commit them). Point the app's pet-pack directory here to try them.
/.pet/

# Cubism SDK subset used by the in-repo Live2D renderer. Fetched by
# tool/fetch_live2d_sdk.ps1 - never committed.
/third_party/live2d/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.metadata

# Android build artifacts
android/build/
android/.gradle/
android/local.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json
