{
  "name": "default",
  "version": 1,
  "frameWidth": 200,
  "frameHeight": 200,
  "initialState": "idle",

  "animations": {
    "idle":  { "folder": "idle",  "fps": 16, "frameCount": 16 },
    "walk":  { "folder": "walk",  "fps": 10, "frameCount": 8 },
    "sleep": { "folder": "sleep", "fps": 16, "frameCount": 37 },
    "happy": { "folder": "happy", "fps": 10, "frameCount": 7 },
    "eat":   { "folder": "eat",   "fps": 8,  "frameCount": 7 },
    "drag":  { "folder": "drag",  "fps": 6,  "frameCount": 25 }
  },

  "states": {
    "idle": {
      "animation": "idle",
      "repeatCount": "infinite",
      "transitions": [
        { "trigger": "timer",  "target": "perWalk",  "minMs": 15000, "maxMs": 15000 },
        { "trigger": "timer",  "target": "sleep", "afterMs": 120000 },
        { "trigger": "click",  "target": "happy" },
        { "trigger": "eat",    "target": "eat" },
        { "trigger": "drag",   "target": "drag" },
        { "trigger": "window", "target": "sleep", "match": "chrome,firefox,edge,brave,opera,safari,YouTube,Netflix,bilibili" },
        {"trigger": "window", "target": "game-idle","match": "MONSTER HUNTER:WORLD"}
      ]
    },
    "game-idle": {
      "animation": "idle",
      "repeatCount": "infinite",
      "transitions": [
        {"trigger": "click", "target": "idle"},
        { "trigger": "drag",   "target": "drag" }
      ]
    },
    "perWalk": {
      "animation": "idle",
      "behavior": "moveToTarget",
      "repeatCount": "infinite",
      "transitions": [
        {"trigger": "moveRight", "target": "walk"},
        {"trigger": "moveLeft", "target": "walk-mirror"}
      ]

    },
    "walk": {
      "animation": "walk",
      "repeatCount": "infinite",
      "behavior": "moveToTarget",
      "scaleY": "1 - 0.05*(1 - cos(2*PI*t))",
      "transitions": [
        { "trigger": "arrived", "target": "idle" },
        { "trigger": "click",   "target": "happy" },
        { "trigger": "drag",    "target": "drag" }
      ]
    },
    "walk-mirror": {
      "animation": "walk",
      "repeatCount": "infinite",
      "behavior": "moveToTarget",
      "mirrorH": true,
      "scaleY": "1 - 0.05*(1 - cos(2*PI*t))",
      "transitions": [
        { "trigger": "arrived", "target": "idle" },
        { "trigger": "click",   "target": "happy" },
        { "trigger": "drag",    "target": "drag" }
      ]
    },
    "sleep": {
      "animation": "sleep",
      "repeatCount": "infinite",
      "transitions": [
        {"trigger": "timer", "target": "idle", "afterMs": 12000},
        { "trigger": "click", "target": "idle" },
        { "trigger": "eat",   "target": "idle" },
        { "trigger": "drag",  "target": "drag" }
      ]
    },
    "happy": {
      "animation": "happy",
      "transitions": [
        { "trigger": "click", "target": "happy" },
        { "trigger": "drag", "target": "drag" },
        { "trigger": "complete", "target": "idle"}
      ]
    },
    "eat": {
      "animation": "eat",
      "transitions": [
        { "trigger": "drag", "target": "drag" },
        { "trigger": "complete", "target": "idle"}
      ]
    },
    "drag": {
      "animation": "drag",
      "repeatCount": "infinite",
      "rotation": "sin(t * PI * 2) * 0.1",
      "offsetX": "sin(t * PI * 4) * 3",
      "transitions": [
        { "trigger": "arrived", "target": "idle" }
      ]
    }
  }
}
