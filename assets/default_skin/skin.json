{
  "name": "default",
  "version": 1,
  "frameWidth": 200,
  "frameHeight": 200,
  "initialState": "idle",

  "animations": {
    "idle":  { "folder": "idle",  "fps": 16, "frameCount": 16 },
    "walk":  { "folder": "walk",  "fps": 10, "frameCount": 8 },
    "sleep": { "folder": "sleep", "fps": 16, "frameCount": 37 },
    "happy": { "folder": "happy", "fps": 10, "frameCount": 7 },
    "eat":   { "folder": "eat",   "fps": 8,  "frameCount": 7 },
    "drag":  { "folder": "drag",  "fps": 6,  "frameCount": 25 }
  },

  "states": {
    "idle": {
      "animation": "idle",
      "transitions": {
        "perWalk":    { "limitTimer": { "minMs": 15000, "maxMs": 15000 } },
        "sleep":      { "waitTimer": { "afterMs": 120000 }, "hotkey": { "key": "s", "modifiers": ["ctrl", "alt"] } },
        "happy":      { "click": {} },
        "eat":        { "eat": {} },
        "drag":       { "drag": {} },
        "walkToEdge": { "hotkey": { "key": "k", "modifiers": ["ctrl", "alt"] } }
      }
    },

    "perWalk": {
      "animation": "idle",
      "behavior": "moveToTarget",
      "transitions": {
        "walk":        { "moveRight": {} },
        "walk-mirror": { "moveLeft": {} },
        "sleep":    { "drag": {} }
      }
    },

    "walkToEdge": {
      "animation": "walk",
      "behavior": "moveToTarget",
      "targetPos": { "x": 1920, "y": 1080 },
      "transitions": {
        "EdgeIdle": { "arrived": {} }
      }
    },

    "EdgeIdle": {
      "animation": "idle",
      "offsetY": 50,
      "transitions": {
        "perWalk": { "hotkey": { "key": "k", "modifiers": ["ctrl", "alt"] } },
        "drag":    { "drag": {} }
      }
    },

    "walk": {
      "animation": "walk",
      "behavior": "moveToTarget",
      "scaleY": "1 - 0.05*(1 - cos(2*PI*t))",
      "transitions": {
        "idle":  { "arrived": {} },
        "happy": { "click": {} },
        "drag":  { "drag": {} }
      }
    },
    "walk-mirror": {
      "animation": "walk",
      "behavior": "moveToTarget",
      "mirrorH": true,
      "scaleY": "1 - 0.05*(1 - cos(2*PI*t))",
      "transitions": {
        "idle":  { "arrived": {} },
        "happy": { "click": {} },
        "drag":  { "drag": {} }
      }
    },

    "sleep": {
      "animation": "sleep",
      "transitions": {
        "idle": { "waitTimer": { "afterMs": 12000 }, "click": {} },
        "drag": { "drag": {} }
      }
    },
    "happy": {
      "animation": "happy",
      "playCount": 1,
      "transitions": {
        "happy": { "click": {} },
        "drag":  { "drag": {} },
        "idle":  { "complete": {} }
      }
    },
    "eat": {
      "animation": "eat",
      "playCount": 1,
      "transitions": {
        "drag": { "drag": {} },
        "idle": { "complete": {} }
      }
    },
    "drag": {
      "animation": "drag",
      "rotation": "sin(t * PI * 2) * 0.1",
      "offsetX": "sin(t * PI * 4) * 3",
      "transitions": {
        "idle": { "arrived": {} }
      }
    }
  }
}
